# Cert-hygiene lab settings. Copy to config.local.env (gitignored) to override.

# ---- Lab machine (OrbStack) ----
LAB_VM=cert-hygiene-lab
LAB_CPUS=4
LAB_MEM=6G
LAB_DISK=40G

# ---- Versions ----
LINKERD_EDGE_VERSION=edge-26.9.1     # CLI and control plane; recorded in every run
GATEWAY_API_VERSION=v1.5.1           # applied with kubectl apply --server-side

# ---- Lab namespace ----
LAB_NS=lab

# ---- Credentials ----
# Anchor, issuer, leaf and webhook lifetimes live in lab/profiles/<profile>.env.
# The issuer R signs during recovery, from the same anchor.
REPLACEMENT_ISSUER_LIFETIME=8760h
# The control's T_mark sits this long after its issuer's notBefore: where R's
# issuer-short issuer would expire, so both runs snapshot the same moments.
CONTROL_T_MARK_AFTER=15m
# K: the default issuer applied for the +10m side of the 60-day boundary (1440h + 10m).
# A bisect run can override this per-invocation with
# run.sh 20-check-threshold <lifetime> instead of editing this file; the value used is
# always recorded in the run's versions.txt.
K_PLUS_ISSUER_LIFETIME=1440h10m
# A and S: lifetime of the new trust anchor that recovery or rotation creates.
NEW_ANCHOR_LIFETIME=87600h

# ---- Timing (seconds) ----
PROBE_INTERVAL_S=2
OBSERVE_INTERVAL_S=30
POST_EXPIRY_WINDOW_S=1800   # R's window (design 2); the control mirrors it
RECOVER_WINDOW_S=300
# W: its post-expiry window, counted from the last webhook expiry (T3; design section 3).
W_POST_WINDOW_S=600
# W: after that window, the webhook Deployments are restarted (forced API-server
# reconnect) and admission probes run on every tick for this long before recovery.
W_RECONNECT_WINDOW_S=180
# V: after its post-expiry window, the tap Deployment is restarted (forced API-server
# reconnect, Task 3b) and tap/check/APIService probes run on every tick for this long.
V_RECONNECT_WINDOW_S=180
# Fault-driven scenarios (O, S-staged, S-hard): observation time before the fault.
FAULT_LEAD_S=600
# O: identity outage, longer than a 5m leaf plus the 20s clock-skew allowance.
OUTAGE_S=900
# S-hard: stage 1 ends when every unrestarted endpoint's old leaf has expired and failed
# (or it renewed); past this many seconds after the swap, the run is invalid.
S_HARD_STAGE1_TIMEOUT_S=900
# Discovery runs launched with --short only (scripts/run.sh --discovery --short): each
# window is lowered to this value, never raised. Evidence runs refuse the override.
DISCOVERY_POST_WINDOW_S=420
DISCOVERY_RECOVER_WINDOW_S=120
DISCOVERY_W_POST_WINDOW_S=120
DISCOVERY_W_RECONNECT_WINDOW_S=60
DISCOVERY_V_RECONNECT_WINDOW_S=60

# Restart-stage gates (design 1.6). GATE_TIMEOUT_S is set from measured healthy
# restarts (Task 7 discovery, runs/_discovery/<stamp>-gates/FINDINGS.md).
GATE_TIMEOUT_S=150
GATE_POLL_S=5
GATE_SAMPLES=10
GATE_SAMPLE_INTERVAL_S=2

# ---- Workload images (pinned by digest; regenerate with lab/resolve-images.sh) ----
IMAGE_CURL=docker.io/curlimages/curl@sha256:58adaa4e8dca9c988bae2aba4ab3434a0bb2da16bbe3f92dec39ec7785166777   # pinned from docker.io/curlimages/curl:latest on 2026-09-11
IMAGE_SOCAT=docker.io/alpine/socat@sha256:ef6c281978dcd6927d9b3829484e4c4fdfc5d98de5acbd6312c04565d2d58cbf   # pinned from docker.io/alpine/socat:latest on 2026-09-11
IMAGE_BUSYBOX=docker.io/library/busybox@sha256:dc2d74b28e4cf8984fa52af1f39bc7c3d9c73760b41a74d629f5d11b1ab28616   # pinned from docker.io/library/busybox:latest on 2026-09-11

# ---- Metrics (confirmed by lab/discover.sh; see runs/_discovery/) ----
LEAF_EXPIRY_METRIC=control_identity_cert_expiration_timestamp_seconds
ISSUER_TTL_METRIC=issuer_cert_ttl_seconds

# ---- W: webhook names in admission rejections (Task 1 discovery) ----
POLICY_VALIDATOR_WEBHOOK_NAME=linkerd-policy-validator.linkerd.io
SP_VALIDATOR_WEBHOOK_NAME=linkerd-sp-validator.linkerd.io
# How long W's recovery waits for all three webhooks to serve correctly after a change.
W_PROPAGATION_TIMEOUT_S=180
# Lifetime of the fresh lab-supplied webhook credentials W's branches ii and iii apply.
W_FRESH_WEBHOOK_LIFETIME=8760h
