# G (design section 4, slice 4): lab-supplied webhook serving certificates, all
# long-lived and untouched by installation -- scenario_fault (lab/scenario-g.sh) swaps
# only profileValidator's after the baseline, and restores it before the run ends.
# failurePolicy=Fail on every webhook (Task 4's ruling): under Ignore the client sees
# nothing and only the journal records the refusal, but G1 is about the error the API
# server returns. Viz is deliberately not installed (Task 3's finding: linkerd viz check
# has nothing to say about this webhook, and TAP_CERT_LIFETIME set would only clutter the
# evidence with "namespace not found").
ANCHOR_LIFETIME=87600h
ISSUER_LIFETIME=8760h
LEAF_LIFETIME=5m
WEBHOOK_CERT_LIFETIMES="proxyInjector=24h policyValidator=24h profileValidator=24h"
EXTRA_INSTALL_FLAGS="--set webhookFailurePolicy=Fail"
TAP_CERT_LIFETIME=
