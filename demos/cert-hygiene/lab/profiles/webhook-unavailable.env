# N (Ignore, design section 3, slice 4): lab-supplied webhook serving certificates, all
# long-lived and never touched by the scenario -- nothing expires here, which is the
# point (N is a control: the failure is the proxy-injector Deployment being unavailable,
# not its certificate).
ANCHOR_LIFETIME=87600h
ISSUER_LIFETIME=8760h
LEAF_LIFETIME=5m
WEBHOOK_CERT_LIFETIMES="proxyInjector=24h policyValidator=24h profileValidator=24h"
EXTRA_INSTALL_FLAGS=
TAP_CERT_LIFETIME=
