# ---- Compute (VM names + sizing) ----
CLUSTER_VM=linkerd-cluster
EDGE_VM=linkerd-edge
CLUSTER_CPUS=4
EDGE_CPUS=2
# libvirt (Linux, the recommended topology) sizes in MiB/GiB:
CLUSTER_MEM_MIB=6144
CLUSTER_DISK_GB=40
EDGE_MEM_MIB=3072
EDGE_DISK_GB=20
# Lima (macOS fallback) sizes:
CLUSTER_MEM=8GiB
EDGE_MEM=4GiB

# ---- Reachability ----
# Defaults are the addresses `just demo spiffe-cross-boundary cluster-up/edge-up`
# assigns on Linux: two libvirt VMs pinned by DHCP reservation on virbr0. They
# work as-is for that topology. Change them for any other (two physical hosts,
# Lima on macOS, a tailnet) to whatever addresses those boxes actually have.
CLUSTER_NODE_ADDR=192.168.122.10     # how the edge reaches the cluster node
EDGE_ADDR=192.168.122.11             # how the cluster reaches the edge workload

# ---- libvirt topology (Linux) ----
LIBVIRT_NET=default
VM_USER=demo
#VM_IMAGE_URL=https://cloud-images.ubuntu.com/releases/24.04/release/ubuntu-24.04-server-cloudimg-amd64.img
#DEMO_SSH_KEY=~/.ssh/linkerd-playground

# ---- Cluster networking (k3s defaults) ----
POD_CIDR=10.42.0.0/16
SVC_CIDR=10.43.0.0/16
COREDNS_ADDR=10.43.0.10              # kube-dns ClusterIP (k3s default)

# ---- Versions / identity ----
LINKERD_EDGE_VERSION=edge-26.7.2     # pin CLI + proxy to the SAME value
DEMO_NS=mixed-env
# The RetailCloud demo's on-prem workload (default). For the original abstract
# CLI beats instead, set these three to the edge-echo values (see README appendix).
EDGE_WORKLOAD_NAME=store-pos
EDGE_SPIFFE_ID=spiffe://root.linkerd.cluster.local/store/042/inventory-sync
EDGE_SERVER_NAME=inventory-sync.cluster.local

# ---- SPIRE (server in the cluster; agent-only on the edge) ----
SPIRE_VERSION=1.15.2
SPIRE_SERVER_PORT=30081                                                   # NodePort of the in-cluster SPIRE server
# Interface the SPIRE NodePort is restricted to: the one the EDGE box reaches the
# cluster host on. apply.sh works this out from EDGE_ADDR automatically, so you
# normally leave this alone; set it only to override (e.g. tailscale0 when using
# the optional overlay recipe).
#SPIRE_NODEPORT_IFACE=enp1s0
SPIRE_AGENT_SPIFFE_ID=spiffe://root.linkerd.cluster.local/store/042/agent # the edge node identity
PROXY_UID=2102                                                           # dedicated non-root user the proxy runs as
# The store-pos app's uid; edge/iptables.sh redirects ALL of this uid's outbound
# TCP through the proxy. On a bare-metal Linux edge box, 1000 is normally the
# primary human user -- set this to an unused uid there, or their shell's traffic
# gets redirected too. Safe to leave alone on a throwaway VM.
APP_UID=1000
