---
// Site-wide footer: render Starlight's default footer (pagination, etc.),
// then append a "Made with Claude Code" disclaimer line.
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default>
	<slot />
</Default>

<p class="made-with-claude">
	Made with <a href="https://claude.com/claude-code">Claude Code</a>.
</p>

<style>
	.made-with-claude {
		margin: 1.5rem 0 0;
		padding-top: 1rem;
		border-top: 1px solid var(--sl-color-gray-5);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		text-align: center;
	}
</style>
