# build output
dist/
# generated types
.astro/

# sync-docs output: these pages are generated from demos/<slug>/{MANUAL,PRODUCTION-NOTES}.md
# by scripts/sync-docs.mjs (prebuild/predev hook), so they are build artifacts, not source.
# The hand-authored pages in the same dir (concepts/overview/reference.md) stay tracked.
src/content/docs/demos/*/manual.md
src/content/docs/demos/*/production-notes.md

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store
